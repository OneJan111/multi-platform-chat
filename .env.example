# Streaming Dashboard settings
# Copy this file to .env and fill in only the platforms you use.
# Cookie values are normally written by the app from the 🍪 Cookies tab.

# ── YouTube ──────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=your-youtube-api-key
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:8501/
YOUTUBE_COOKIE=SID=xxx; HSID=xxx; SSID=xxx; APISID=xxx; SAPISID=xxx

# ── Bilibili ─────────────────────────────────────────────────────────────────
BILIBILI_ROOM_ID=12345678
BILIBILI_SESSDATA=your-sessdata
BILIBILI_BILI_JCT=your-bili-jct
BILIBILI_BUVID3=your-buvid3
BILIBILI_DEDEUSERID=12345678

# ── MissEvan (猫耳FM) ─────────────────────────────────────────────────────────
MISSEVAN_ROOM_ID=869215180
MISSEVAN_COOKIE=token=xxx; FM_SESS=xxx

# ── OBS WebSocket ────────────────────────────────────────────────────────────
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=your-obs-password

# ── App ──────────────────────────────────────────────────────────────────────
TTS_USE_GTTS=false
CHAT_POLL_INTERVAL=5
