# Streaming Dashboard settings
# Copy this file to .env and fill in only the platforms you use.
# Site logins are NOT set here: each user imports their own cookies in the 🍪 Cookies tab.

# ── YouTube ──────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=your-youtube-api-key
YOUTUBE_CHANNEL=https://www.youtube.com/@Ya-chan

# ── Bilibili ─────────────────────────────────────────────────────────────────
BILIBILI_ROOM_ID=25760587

# ── MissEvan (猫耳FM) ─────────────────────────────────────────────────────────
MISSEVAN_ROOM_ID=869215180

# ── OBS WebSocket ────────────────────────────────────────────────────────────
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=your-obs-password

# ── Chat overlay (OBS Browser Source) ────────────────────────────────────────
# 127.0.0.1 = this computer only; 0.0.0.0 = reachable from other machines (e.g. dashboard on a server)
OVERLAY_HOST=127.0.0.1
OVERLAY_PORT=8502
# Optional: address shown in the dashboard for OBS, e.g. http://203.0.113.5:8502
# OVERLAY_PUBLIC_URL=

# ── App ──────────────────────────────────────────────────────────────────────
# Key that encrypts each user's logins in their own browser. Optional: a random key is
# generated in .login_secret. Streamlit hosts can set LOGIN_SECRET in their TOML secrets.
# Changing it logs everyone out.
# LOGIN_SECRET=
# Translation provider: google (default) or deepl.
# DeepL requires an API key; use api-free.deepl.com for DeepL API Free, or set
# DEEPL_TRANSLATE_URL to https://api.deepl.com/v2/translate for DeepL API Pro.
TRANSLATION_PROVIDER=google
# DEEPL_API_KEY=
# DEEPL_TRANSLATE_URL=https://api-free.deepl.com/v2/translate
TTS_USE_GTTS=false
CHAT_POLL_INTERVAL=5
