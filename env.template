# Streaming Dashboard settings
# Copy this file to .env and fill in only the platforms you use.
# Site logins are NOT set here: each user imports their own cookies in the 🍪 Cookies tab.

# ── YouTube ──────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=your-youtube-api-key
YOUTUBE_CHANNEL=https://www.youtube.com/@Ya-chan

# ── Bilibili ─────────────────────────────────────────────────────────────────
BILIBILI_ROOM_ID=25760587

# ── MissEvan (猫耳FM) ─────────────────────────────────────────────────────────
MISSEVAN_ROOM_ID=869215180

# ── OBS WebSocket ────────────────────────────────────────────────────────────
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=your-obs-password

# ── Chat overlay (OBS Browser Source) ────────────────────────────────────────
# 127.0.0.1 = this computer only; 0.0.0.0 = reachable from other machines (e.g. dashboard on a server)
OVERLAY_HOST=127.0.0.1
OVERLAY_PORT=8502
# Optional: address shown in the dashboard for OBS, e.g. http://203.0.113.5:8502
# OVERLAY_PUBLIC_URL=
# Optional: require this bearer token for overlay requests proxied by EdgeOne.
# Use the same random secret in the EdgeOne OVERLAY_PROXY_TOKEN setting.
# OVERLAY_PROXY_TOKEN=

# ── App ──────────────────────────────────────────────────────────────────────
# Hide the Analytics page and stop recording viewer history and hotspot data.
ANALYTICS_ENABLED=false
# Key that encrypts each user's logins in their own browser. Optional: a random key is
# generated in .login_secret. Streamlit hosts can set LOGIN_SECRET in their TOML secrets.
# Changing it logs everyone out.
# LOGIN_SECRET=
# Translation provider: index (default), openai_compatible, or google.
# OpenAI-compatible mode uses the configured API endpoint and never falls back to another provider.
TRANSLATION_PROVIDER=index
# OpenAI-compatible chat-completions API. For LM Studio, use http://localhost:1234/v1.
# For hosted providers, use their API base URL, model ID, and API key.
# Legacy LM_STUDIO_TRANSLATE_* settings are still read if the generic setting is unset.
OPENAI_COMPATIBLE_TRANSLATE_API_BASE=http://localhost:1234/v1
OPENAI_COMPATIBLE_TRANSLATE_MODEL=local-model
# Optional for local servers; required by most hosted providers.
# OPENAI_COMPATIBLE_TRANSLATE_API_KEY=
# Index-Translate is tried first when TRANSLATION_PROVIDER=index; Google is used if it fails.
# Set INDEX_TRANSLATE_API_BASE empty to disable the primary Index-Translate service.
INDEX_TRANSLATE_API_BASE=https://index-translate.bilibili.com/v1
INDEX_TRANSLATE_MODEL=Index-Translate-35B-A3B
TTS_USE_GTTS=false
# Optional desktop Python allocation diagnostics (adds CPU/RAM overhead).
# Logs traced bytes every 10s and top allocation growth locations every 60s.
# Restart after changing; disable after diagnosis.
MEMORY_TRACE_ENABLED=false
# TTS limits (positive integers). Restart after changing.
# Offline normal/priority queues drop oldest messages when full.
TTS_QUEUE_LIMIT=20
TTS_PRIORITY_QUEUE_LIMIT=50
# Desktop synthesis tasks (including running tasks) skip incoming speech when full.
TTS_TASK_LIMIT=20
# Desktop online audio waiting for playback drops oldest audio when full.
TTS_AUDIO_QUEUE_LIMIT=20
# Show the experimental transcription page and live preview. Restart after changing.
TRANSCRIPTION_ENABLED=false
# Chat polling and feed refresh intervals for simple_app.py and simple_server_app.py (seconds).
# The server-history variant keeps collecting in the background at this interval while browsers disconnect.
SIMPLE_CHAT_POLL_INTERVAL=15
# Live-status, title, viewer-count, and channel-watch refresh interval for the simple monitors (seconds).
SIMPLE_STATUS_POLL_INTERVAL=60
CHAT_POLL_INTERVAL=5
# immediate = show chat right away and add translations when ready; wait = show each message after translation is ready.
CHAT_TRANSLATION_DISPLAY_MODE=immediate
# Desktop/browser live-status, title, viewer count and YouTube channel-watch interval.
# Seconds, minimum 1. Live alerts follow status polls. Restart after changing.
ROOM_STATUS_POLL_INTERVAL=60
# Default chat/transcription display limit (10-200); saved browser preferences take priority.
MAX_CHAT_DISPLAY=50
# Render emoji/sticker/gift images in the dashboard. Saved browser preferences take priority.
RENDER_CHAT_IMAGES=true

# Simple monitor defaults for new sessions; sidebar changes take priority within a session.
# Page language: en, zh, or ja. Chat translation targets this language.
SIMPLE_PAGE_LANGUAGE=ja
SIMPLE_TRANSLATION_ENABLED=true
# Read translated chat when TTS is enabled (does not enable TTS itself).
SIMPLE_TTS_TRANSLATE=true
# Browser notification permission is still required.
SIMPLE_NOTIFY_LIVE=true
# Combined chat, Super Chat and gift message limit in the simple monitor's standalone OBS link (1-50).
SIMPLE_OVERLAY_COUNT=10
